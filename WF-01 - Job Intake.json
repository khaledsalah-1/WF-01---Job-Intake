        "jsCode": "const items = $input.all();\nconst output = [];\nfor (const item of items) {\n  const body = item.json.body || item.json;\n  let contentType = \"text\";\n  let rawText = \"\";\n  let jobUrl = \"\";\n  let binary = item.binary;\n  if (binary && Object.keys(binary).length > 0) {\n    const firstKey = Object.keys(binary)[0];\n    binary = { data: binary[firstKey] };\n    contentType = \"pdf\";\n  } else if (body.job_url) {\n    contentType = \"url\";\n    jobUrl = body.job_url;\n  } else {\n    contentType = \"text\";\n    rawText = body.raw_text || body.text || JSON.stringify(body);\n  }\n  output.push({ json: { contentType: contentType, rawText: rawText, jobUrl: jobUrl, sourceType: \"webhook\" }, binary: binary });\n}\nreturn output;"
      },

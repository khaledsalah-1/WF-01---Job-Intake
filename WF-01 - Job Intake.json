      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\nfor (const item of items) {\n  const text = (item.json.message && item.json.message.text) ? item.json.message.text : \"\";\n  const isUrl = /^https?:\\/\\//i.test(text.trim());\n  output.push({ json: { contentType: isUrl ? \"url\" : \"text\", rawText: isUrl ? \"\" : text, jobUrl: isUrl ? text.trim() : \"\", sourceType: \"telegram\" } });\n}\nreturn output;"
      },
